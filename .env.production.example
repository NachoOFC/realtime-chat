# Backend en Render. Configura estos valores en su panel; no copies credenciales a Git.
APP_ENV=production
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST_NEON/BASE?sslmode=require
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO

# URL del frontend en Netlify, sin barra final.
CORS_ORIGIN=https://tu-chat.netlify.app
FRONTEND_URL=https://tu-chat.netlify.app

# OAuth vuelve al frontend. Su proxy entrega el callback al backend de Render.
GOOGLE_CLIENT_ID=TU_CLIENTE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_SECRETO_DE_GOOGLE
GOOGLE_REDIRECT_URL=https://tu-chat.netlify.app/api/auth/google/callback

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
ACCESS_TOKEN_TTL=24h
WS_TICKET_TTL=30s

# Render termina HTTPS y proporciona PORT. Deja estos valores sin configurar.
# HTTP_ADDR toma :PORT automáticamente cuando no se especifica.
HTTP_ADDR=
TLS_CERT_FILE=
TLS_KEY_FILE=
