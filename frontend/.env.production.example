# Configura estas variables en Netlify con alcance de Builds y Functions.
# El destino privado del proxy no se incorpora al código del navegador.
NUXT_API_PROXY_TARGET=https://tu-chat-api.onrender.com

# El navegador llama a /api en el mismo origen de Netlify.
# Deja esta variable vacía o elimínala de Netlify si antes apuntaba al backend.
NUXT_PUBLIC_API_BASE=

# El WebSocket conecta directamente a Render usando un ticket de un solo uso.
NUXT_PUBLIC_WS_BASE=wss://tu-chat-api.onrender.com
NUXT_DEV_TLS=false
