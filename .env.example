# Base de datos (docker-compose y backend)
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=chat
POSTGRES_PORT=5432
DATABASE_URL=postgres://chat:chat@localhost:5432/chat?sslmode=disable

# Backend
APP_ENV=development
HTTP_ADDR=:8080
CORS_ORIGIN=http://localhost:3000

# Sesión: generar con `openssl rand -hex 32` en producción
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL=24h
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
